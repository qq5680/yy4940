{
  "pluginId": "videosection",
  "version": "1.0.0",
  "apiVersion": 1,
  "liveTypes": ["videosection"],
  "entry": "index.js",
  "displayName": "VideoSection",
  "platformDescription": "VideoSection 直播（Stripchat 白牌，多分类 + 多画质 + 广告过滤）",
  "changelog": [
    "1.0.0：初始版本：女生/情侣分类、搜索、多画质播放、过滤宣传广告"
  ],
  "auth": {
    "required": false,
    "loginType": "webview",
    "loginURL": "https://zh.videosection.live/",
    "cookieDomains": ["videosection.live", ".videosection.live", "zh.videosection.live"],
    "authSignalCookies": ["sessionId", "csrftoken"]
  },
  "hostBehavior": {
    "favoriteIdentityKey": "roomId",
    "preserveFavoriteRoomInfoOnRefresh": true,
    "liveStateFailureFallback": "unknow",
    "supportsLiveEndPolling": true,
    "playableLiveStates": ["live"],
    "externalRoomURLTemplate": "https://zh.videosection.live/{userName}",
    "themeColor": "#5B5FC7"
  },
  "shareResolve": {
    "hosts": ["videosection.live", "zh.videosection.live", "www.videosection.com"],
    "keywords": ["VideoSection", "videosection"]
  },
  "capabilities": {
    "categories": "available",
    "rooms": "available",
    "playback": "available",
    "search": "available",
    "roomDetail": "available",
    "liveState": "available",
    "shareResolve": "available",
    "danmaku": "unavailable"
  }
}
